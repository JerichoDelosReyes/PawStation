# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://ztwmlfdyllevyxbgzokd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Direct Database Connection URL (for local migrations / Prisma / Drizzle)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ztwmlfdyllevyxbgzokd.supabase.co:5432/postgres

# HiveMQ Cloud MQTT Broker (WebSocket over TLS on port 8884)
NEXT_PUBLIC_HIVEMQ_HOST=your-cluster-id.s1.eu.hivemq.cloud
NEXT_PUBLIC_HIVEMQ_PORT=8884
NEXT_PUBLIC_HIVEMQ_PATH=/mqtt
NEXT_PUBLIC_HIVEMQ_USER=pawstation-web
NEXT_PUBLIC_HIVEMQ_PASS=your-strong-web-password
